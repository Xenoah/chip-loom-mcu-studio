{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: core",
      "type": "shell",
      "command": "cargo build --bin chiploom",
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "build: extension",
      "type": "shell",
      "command": "npm run compile",
      "options": { "cwd": "${workspaceFolder}/extension" },
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "build: extension and core",
      "dependsOrder": "sequence",
      "dependsOn": ["build: core", "build: extension"],
      "problemMatcher": []
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "cargo test --workspace && cd extension && npm test",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
